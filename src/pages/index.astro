---
import '../styles/fonts.css';
import '../styles/global.css';
import '../styles/readability.css';
import Icon from '../components/Icon.astro';
import ProjectVisual from '../components/ProjectVisual.astro';
import { profile, navigation, projects, capabilities, stack } from '../data/portfolio';
const title = 'Pablo Amion | Backend, Fullstack & Data Engineering';
const description = 'Portafolio de Pablo Amion: desarrollo backend y fullstack, ingeniería de datos, automatización e IA aplicada. Proyectos reales desde Santiago, Chile.';
const site = Astro.site || new URL('https://pabloamion.is-a.dev');
const schema = { '@context': 'https://schema.org', '@type': 'ProfilePage', name: title, url: site.href, mainEntity: { '@type': 'Person', name: profile.name, url: site.href, sameAs: [profile.github, profile.linkedin], knowsAbout: ['Backend development', 'Data Engineering', 'Fullstack development', 'Python', 'Java', 'TypeScript'], alumniOf: { '@type': 'EducationalOrganization', name: 'INACAP' } } };
---
<!doctype html>
<html lang="es-CL">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#080d16" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={site.href} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_CL" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={site.href} />
    <meta property="og:image" content={new URL('/og-cover.png', site).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <div class="reading-progress" aria-hidden="true"></div>
    <header class="mobile-header">
      <a href="#inicio" class="wordmark" aria-label="Pablo Amion, inicio"><span class="brand-symbol">p<span>.</span></span><span>PABLO AMION<small>ENGINEERING & DEVELOPMENT</small></span></a>
      <button class="icon-button menu-trigger" aria-label="Abrir navegación" aria-haspopup="dialog" aria-controls="mobile-menu"><Icon name="menu" /></button>
    </header>

    <aside class="sidebar" aria-label="Barra lateral">
      <a href="#inicio" class="wordmark" aria-label="Pablo Amion, inicio"><span class="brand-symbol">p<span>.</span></span><span>PABLO<br />AMION<small>PORTFOLIO / 2026</small></span></a>
      <div class="sidebar-middle"><span class="nav-eyebrow">EXPLORAR</span><nav aria-label="Navegación principal">{navigation.map((item, index) => <a href={`#${item.id}`} data-nav={item.id} class:list={['nav-link', { active: index === 0 }]} aria-current={index === 0 ? 'location' : undefined}><Icon name={item.icon} size={18} /><span>{item.label}</span><small>0{index + 1}</small></a>)}</nav><button class="command-trigger"><Icon name="terminal" size={17} /><span>Ir a…</span><kbd>Ctrl K</kbd></button></div>
      <div class="sidebar-bottom"><div class="local-time"><span class="tiny-dot"></span> SANTIAGO, CL <time id="local-time"></time></div><div class="social-links"><a href={profile.github} target="_blank" rel="noopener noreferrer" aria-label="GitHub de Pablo Amion (nueva pestaña)"><Icon name="github" size={18} /></a><a href={profile.linkedin} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn de Pablo Amion (nueva pestaña)"><Icon name="linkedin" size={18} /></a><a href={`mailto:${profile.email}`} aria-label="Enviar correo a Pablo Amion"><Icon name="mail" size={18} /></a><a href="/PabloAmion_CV.pdf" download aria-label="Descargar CV en PDF"><Icon name="download" size={18} /></a></div><span class="sidebar-note">Ideas → código → impacto<span>Hecho con intención.</span></span></div>
    </aside>

    <main id="contenido">
      <section id="inicio" class="hero section-anchor" aria-labelledby="hero-title">
        <div class="hero-top"><span class="mono muted">&lt;portfolio version="2026" /&gt;</span><a href="/PabloAmion_CV.pdf" download class="text-link">Descargar CV <Icon name="download" size={16} /></a></div>
        <div class="hero-grid"><div class="hero-copy"><div class="eyebrow"><span class="tiny-dot"></span> BACKEND · FULLSTACK · DATOS</div><p class="hero-intro">Hola, soy Pablo Amion <span class="wave">↗</span></p><h1 id="hero-title">Código con<br />propósito.<br /><span>Impacto real.</span></h1><p class="hero-description">Transformo procesos complejos en soluciones claras. Desarrollo software, conecto datos y aplico IA a problemas que importan.</p><div class="hero-actions"><a class="button button-primary" href="#proyectos">Explorar proyectos <Icon name="right" size={18} /></a><a class="button button-secondary" href="#contacto">Conversemos <Icon name="arrow" size={17} /></a></div><div class="hero-location"><Icon name="pin" size={15} /><span>Santiago, Chile</span><i></i><span>Ingeniería Informática</span></div></div>
          <div class="hero-art" aria-hidden="true"><div class="art-grid"></div><span class="art-coordinate coordinate-top">SYSTEM / P.A.</span><span class="art-coordinate coordinate-bottom">BUILDING WITH PURPOSE_</span><div class="orbit orbit-one"></div><div class="orbit orbit-two"></div><div class="orbit orbit-three"></div><div class="orbit-track"><span></span></div><div class="core-glow"></div><div class="core-mark"><span>&lt;</span>p<span>/&gt;</span><small>ENGINEER MINDSET</small></div><div class="orbit-node node-data"><Icon name="database" size={18} /><span>DATA</span></div><div class="orbit-node node-code"><Icon name="code" size={18} /><span>CODE</span></div><div class="orbit-node node-ai"><Icon name="spark" size={18} /><span>AI</span></div><div class="hero-terminal"><div class="terminal-bar"><span><i></i><i></i><i></i></span><small>pablo@dev ~</small><span class="terminal-lamp"></span></div><div class="terminal-code"><span class="muted">$ whoami</span><p><span class="code-purple">const</span> developer = {'{'}</p><p>&nbsp; focus: <span class="code-green">"solve real problems"</span>,</p><p>&nbsp; mindset: <span class="code-green">"always learning"</span></p><p>{'}'}<span class="cursor">▍</span></p></div></div></div>
        </div>
        <div class="about-strip"><div><span class="section-index">01 / SOBRE MÍ</span><h2>La tecnología tiene sentido<br />cuando le sirve a alguien.</h2></div><div><p>Mi experiencia une el soporte TI en terreno con el desarrollo de software y la ingeniería de datos. Me interesa entender la operación, construir con criterio y dejar soluciones que otros puedan mantener.</p><span class="education"><Icon name="book" size={16} /> Analista Programador · Ingeniería Informática, último semestre en INACAP.</span></div></div>
        <a class="scroll-cue" href="#proyectos"><span>EL TRABAJO HABLA</span><Icon name="down" size={16} /></a>
      </section>

      <section id="proyectos" class="content-section section-anchor" aria-labelledby="projects-title">
        <div class="section-heading"><div><span class="section-index">02 / PROYECTOS SELECCIONADOS</span><h2 id="projects-title">Ideas que llegaron<br />al <span class="serif-accent">código.</span></h2></div><p>Arquitectura, decisiones y resultados.<br />Una selección de lo que me gusta construir.</p></div>
        <div class="project-toolbar"><div class="filters" role="group" aria-label="Filtrar proyectos por especialidad">{['Todos', 'Datos & IA', 'Desarrollo web', 'Backend', 'QA'].map((filter, index) => <button class:list={['filter-button', { selected: index === 0 }]} data-filter={filter} aria-pressed={index === 0}>{filter}{index === 0 && <span>{projects.length.toString().padStart(2, '0')}</span>}</button>)}</div><span class="project-count mono" role="status" aria-live="polite"><span id="project-count">07</span> proyectos</span></div>
        <div class="projects-grid">{projects.map((project, index) => <article class:list={['project-card', { 'project-featured': index === 0 }]} data-category={project.category}>
          <button class="visual-open" data-project={project.id} aria-label={`Ver caso de ${project.title}`}><ProjectVisual type={project.visual} /><span class="visual-open-icon"><Icon name="arrow" size={20} /></span></button>
          <div class="project-body"><span class="project-label">{project.label}</span><h3><button data-project={project.id}>{project.title}</button></h3><p>{project.summary}</p><ul class="tags" aria-label="Tecnologías">{project.tags.map(tag => <li>{tag}</li>)}</ul><div class="project-links"><button class="text-link" data-project={project.id}>Ver caso <Icon name="right" size={16} /></button><div><a href={project.repo} target="_blank" rel="noopener noreferrer" aria-label={`Código de ${project.title} en GitHub (nueva pestaña)`}><Icon name="github" size={17} /><span>Código</span></a>{project.demo && <a href={project.demo} target="_blank" rel="noopener noreferrer" aria-label={`Abrir ${project.title} (nueva pestaña)`}><Icon name="arrow" size={17} /><span>Visitar</span></a>}</div></div></div>
        </article>)}</div><a class="github-more text-link" href={profile.github + '?tab=repositories'} target="_blank" rel="noopener noreferrer">Más exploraciones en GitHub <Icon name="arrow" size={17} /></a>
      </section>

      <section id="servicios" class="content-section section-anchor" aria-labelledby="services-title"><div class="section-heading"><div><span class="section-index">03 / SERVICIOS & CAPACIDADES</span><h2 id="services-title">Del problema<br />a la <span class="serif-accent">solución.</span></h2></div><p>Tres áreas que se complementan.<br />Una visión completa del sistema.</p></div><div class="capabilities-grid">{capabilities.map(item => <article class="capability-card"><div class="capability-top"><span class="capability-icon"><Icon name={item.icon} size={23} /></span><span class="mono muted">/{item.number}</span></div><h3>{item.title}</h3><p>{item.text}</p><ul>{item.items.map(text => <li><Icon name="check" size={15} />{text}</li>)}</ul></article>)}</div><p class="section-note"><Icon name="terminal" size={16} /> Este es mi portafolio personal: una muestra de mis conocimientos, proyectos y forma de trabajar.</p></section>

      <section id="stack" class="content-section section-anchor" aria-labelledby="stack-title"><div class="section-heading"><div><span class="section-index">04 / STACK TÉCNICO</span><h2 id="stack-title">Las herramientas.<br /><span class="serif-accent">El criterio, primero.</span></h2></div><p>Elijo la tecnología por el problema.<br />No al revés.</p></div><div class="stack-grid">{stack.map((group, index) => <article class="stack-card"><div class="stack-card-title"><span class:list={['stack-icon', `stack-color-${index}`]}><Icon name={group.icon} size={21} /></span><div><h3>{group.title}</h3><p>{group.text}</p></div></div><ul class="stack-skills">{group.skills.map(skill => <li><span></span>{skill}</li>)}</ul></article>)}</div></section>

      <section id="impacto" class="content-section section-anchor" aria-labelledby="impact-title"><div class="section-heading"><div><span class="section-index">05 / IMPACTO & RECORRIDO</span><h2 id="impact-title">Más allá<br />del <span class="serif-accent">commit.</span></h2></div><p>El valor está en lo que cambia<br />cuando la solución empieza a funcionar.</p></div><div class="impact-grid"><article class="impact-card impact-main"><span class="project-label">DATOS CON PROPÓSITO SOCIAL</span><strong>48.000<span>+</span></strong><h3>registros consolidados</h3><p>Integración de fuentes, conciliación de identidades y reportería para Déficit Cero, una iniciativa vinculada a la Cámara Chilena de la Construcción.</p><span class="impact-source">Implementación real · resultado documentado en mi CV</span><a class="text-link" href="#proyectos">Conocer el proyecto <Icon name="right" size={16} /></a><div class="impact-lines" aria-hidden="true"></div></article><article class="impact-card"><Icon name="server" size={26} /><strong>300<span>+</span></strong><h3>equipos desplegados</h3><p>Configuración y migración de usuarios en el proyecto Rollout de Colbún, con Active Directory y ServiceNow.</p><span class="impact-source">Experiencia documentada en mi CV</span></article></div><div class="experience"><span class="section-index">EXPERIENCIA QUE CONECTA LAS PIEZAS</span><div class="experience-row"><span class="experience-dot"></span><div><h3>Déficit Cero</h3><span>Práctica de Ingeniería Informática</span></div><p>ETL · gobernanza de datos · dashboards · automatización de reportes</p></div><div class="experience-row"><span class="experience-dot"></span><div><h3>TPF Ingeniería</h3><span>Informática / Soporte TI</span></div><p>Usuarios y activos TI · infraestructura multi-sucursal · soporte remoto</p></div><div class="experience-row"><span class="experience-dot"></span><div><h3>Colbún · Rollout</h3><span>Operador Informático</span></div><p>Despliegue de equipos · Active Directory · ServiceNow</p></div><div class="experience-row"><span class="experience-dot"></span><div><h3>Ripley</h3><span>Informática / Soporte TI</span></div><p>Continuidad operativa · hardware y software · herramientas corporativas</p></div></div></section>

      <section id="contacto" class="contact-section section-anchor" aria-labelledby="contact-title"><div class="contact-grid-bg" aria-hidden="true"></div><div class="contact-copy"><span class="section-index">06 / SIGUIENTE CONVERSACIÓN</span><h2 id="contact-title">Las buenas ideas<br />empiezan con un <span>hola.</span></h2><p>¿Conversamos sobre tecnología, un equipo o el próximo desafío?<br />Me interesa construir donde pueda aportar y seguir aprendiendo.</p><a class="contact-email" href={`mailto:${profile.email}`}>{profile.email}<Icon name="arrow" size={26} /></a><div class="contact-actions"><a class="button button-primary" href={`mailto:${profile.email}`}>Escríbeme <Icon name="mail" size={18} /></a><button class="button button-secondary" id="copy-email"><Icon name="copy" size={17} /><span>Copiar correo</span></button></div><p class="copy-status" role="status" aria-live="polite" id="copy-status"></p><div class="contact-profiles"><a href={profile.github} target="_blank" rel="noopener noreferrer"><Icon name="github" size={18} />GitHub<Icon name="arrow" size={14} /></a><a href={profile.linkedin} target="_blank" rel="noopener noreferrer"><Icon name="linkedin" size={18} />LinkedIn<Icon name="arrow" size={14} /></a><a href="/PabloAmion_CV.pdf" download><Icon name="download" size={18} />CV en PDF<Icon name="down" size={14} /></a></div></div><div class="contact-art" aria-hidden="true"><span>{'{'}</span><i>hello<br />world<span>_</span></i><span>{'}'}</span></div></section>

      <footer><a href="#inicio" class="footer-brand">Pablo Amion<span>© 2026</span></a><span class="footer-middle">Construido con criterio. Y un poco de curiosidad.</span><div class="footer-end"><button id="easter-trigger" aria-label="Descubrir un pequeño guiño a Pokémon y slime" aria-expanded="false" aria-controls="easter-note"><span class="pokeball" aria-hidden="true"></span><span class="slime" aria-hidden="true"><i></i><i></i></span></button><a href="#inicio" class="back-top" aria-label="Volver al inicio">↑</a></div><div id="easter-note" hidden><span>La curiosidad también evoluciona. ⚡</span><a href="https://github.com/pamionj/matriz-pikachu-pixel" target="_blank" rel="noopener noreferrer">De Pikachu a matrices: mi exploración de píxeles e IA ↗</a><small>Y sí, hay un pequeño slime acompañando el viaje.</small></div></footer>
    </main>

    <dialog id="mobile-menu" class="mobile-dialog" aria-labelledby="mobile-menu-title"><div class="dialog-top"><span id="mobile-menu-title" class="mono">EXPLORAR / PABLO AMION</span><button class="icon-button" data-close-dialog aria-label="Cerrar navegación"><Icon name="close" /></button></div><nav aria-label="Navegación móvil">{navigation.map((item, index) => <a href={`#${item.id}`}><span>0{index + 1}</span>{item.label}<Icon name="arrow" size={20} /></a>)}</nav><a class="button button-primary" href="/PabloAmion_CV.pdf" download>Descargar CV<Icon name="download" size={17} /></a><div class="mobile-menu-footer"><span class="tiny-dot"></span> SANTIAGO, CHILE · PORTFOLIO 2026</div></dialog>
    {projects.map(project => <dialog class="project-dialog" id={`case-${project.id}`} aria-labelledby={`case-title-${project.id}`}><div class="dialog-top"><span class="project-label">{project.label}</span><button class="icon-button" data-close-dialog aria-label="Cerrar caso de proyecto"><Icon name="close" /></button></div><ProjectVisual type={project.visual} /><div class="case-content"><h2 id={`case-title-${project.id}`}>{project.title}</h2><p class="case-context">{project.context}</p><ul class="tags">{project.tags.map(tag => <li>{tag}</li>)}</ul><div class="case-story"><div><span>01 / EL DESAFÍO</span><p>{project.challenge}</p></div><div><span>02 / LA SOLUCIÓN</span><p>{project.solution}</p></div><div><span>03 / EL RESULTADO</span><p>{project.outcome}</p></div></div><div class="case-actions"><a class="button button-primary" href={project.repo} target="_blank" rel="noopener noreferrer">Explorar código<Icon name="github" size={17} /></a>{project.demo && <a class="button button-secondary" href={project.demo} target="_blank" rel="noopener noreferrer">Visitar proyecto<Icon name="arrow" size={17} /></a>}</div></div></dialog>)}
    <dialog id="command-dialog" class="command-dialog" aria-labelledby="command-title"><div class="dialog-top"><label id="command-title" for="command-search">¿A dónde vamos?</label><button class="icon-button" data-close-dialog aria-label="Cerrar búsqueda"><Icon name="close" /></button></div><input type="search" id="command-search" placeholder="Buscar sección o proyecto…" autocomplete="off" /><div class="command-results">{navigation.map(item => <a href={`#${item.id}`} data-command-item><Icon name={item.icon} size={18} />{item.label}<span>SECCIÓN ↵</span></a>)}{projects.map(project => <button data-project={project.id} data-command-item data-search={[project.category, ...project.tags].join(" ")}><Icon name="grid" size={18} />{project.title}<span>PROYECTO ↵</span></button>)}</div><p class="command-empty" hidden>Sin resultados. Prueba con “datos”, “Java” o “contacto”.</p><div class="command-hint"><kbd>↑</kbd><kbd>↓</kbd> navegar <kbd>↵</kbd> abrir <kbd>Esc</kbd> cerrar</div></dialog>
    <script>
      import '../scripts/main';
    </script>
  </body>
</html>
